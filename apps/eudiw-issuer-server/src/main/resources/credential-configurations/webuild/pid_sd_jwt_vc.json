{
  "credential_configuration_id": "no.digdir.eudiw.pid_sd_jwt_vc",
  "credential_issuer_context": {
    "credential_datasource_uri": "authoritative-source://freg",
    "credential_signing_keystore": "webuild-provider",
    "authorization_server": "auth-eidas2sandkasse",
    "pre_authorization_server": "maskinporten",
    "include_status": true,
    "grant_type": "authorization_code"
  },
  "credential_type": "urn:eudi:pid:1",
  "format": "dc+sd-jwt",
  "scope": "eudiw:no:pid",
  "credential_metadata": {
    "display": [
      {
        "locale": "no",
        "name": "Norsk ID-bevis (SD-JWT VC)",
        "background_color": "#afcee9",
        "text_color": "#002c54"
      }
    ],
    "claims": [
      {
        "path": [
          "personal_administrative_number"
        ],
        "type": "string",
        "display": [
          {
            "locale": "no",
            "name": "Fødselsnummer"
          }
        ],
        "mandatory": true,
        "validation_regex": "^\\d{11}$"
      },
      {
        "path": [
          "given_name"
        ],
        "type": "string",
        "display": [
          {
            "locale": "no",
            "name": "Førenamn"
          }
        ],
        "mandatory": true
      },
      {
        "path": [
          "family_name"
        ],
        "type": "string",
        "display": [
          {
            "locale": "no",
            "name": "Etternamn"
          }
        ],
        "mandatory": true
      },
      {
        "path": [
          "birthdate"
        ],
        "type": "iso_date",
        "display": [
          {
            "locale": "no",
            "name": "Fødselsdato"
          }
        ],
        "mandatory": true,
        "validation_regex": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      {
        "path": [
          "place_of_birth"
        ],
        "type": "map",
        "display": [
          {
            "locale": "no",
            "name": "Fødeland"
          }
        ],
        "mandatory": true
      },
      {
        "path": [
          "nationalities"
        ],
        "type": "list",
        "display": [
          {
            "locale": "no",
            "name": "Nasjonalitet"
          }
        ],
        "mandatory": true
      },
      {
        "path": [
          "expiry_date"
        ],
        "type": "iso_date",
        "display": [
          {
            "locale": "no",
            "name": "Gyldig til dato"
          }
        ],
        "mandatory": true,
        "validation_regex": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      {
        "path": [
          "issuing_authority"
        ],
        "type": "string",
        "display": [
          {
            "locale": "no",
            "name": "Utsteda av"
          }
        ],
        "mandatory": true
      },
      {
        "path": [
          "issuing_country"
        ],
        "type": "string",
        "display": [
          {
            "locale": "no",
            "name": "Utsteda i land"
          }
        ],
        "mandatory": true
      }
    ]
  }
}
